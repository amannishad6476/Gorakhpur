# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Supports hosted cloud providers (Neon, Supabase, Render Postgres) or local PostgreSQL:
# e.g. DATABASE_URL="postgresql://username:password@ep-xyz.neon.tech/munnalal_painter?sslmode=require"
# e.g. DATABASE_URL="postgresql://postgres:postgres@localhost:5432/munnalal_painter?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/munnalal_painter?schema=public"

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRE=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Munnalal Painter <your_email@gmail.com>

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Admin Initial Setup Credentials (Used for secure server initialization)
ADMIN_EMAIL=amannishad6476@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-password
