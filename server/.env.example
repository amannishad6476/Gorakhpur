# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/munnalal_painter

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Munnalal Painter <your_email@gmail.com>

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin Default Credentials (used for seeding only)
ADMIN_EMAIL=admin@munnalalpainter.com
ADMIN_PASSWORD=Admin@123456
